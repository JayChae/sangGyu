# HTTP caching (Cloudflare Pages).
#
# Rules ACCUMULATE — they do not override. Per Cloudflare's docs: "An incoming
# request which matches multiple rules' URL patterns will inherit all rules'
# headers", and "if a header is applied twice in the _headers file, the values
# are joined with a comma separator".
#
# So an asset rule cannot simply restate Cache-Control: /* still contributes
# its own value and the two get joined into one nonsense header
# ("max-age=0, must-revalidate, public, max-age=3600"). Each asset block first
# detaches the inherited value with "! Cache-Control".
#
# For the same reason X-Content-Type-Options is declared once, on /*, and
# inherited everywhere else. Repeating it would produce "nosniff, nosniff".

/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=0, must-revalidate

# CSS/JS share a contract with the HTML (class names, data-tags), and the HTML
# revalidates on every visit — so keep these short enough that the two cannot
# drift far apart. Filenames are not fingerprinted, so this is the only brake.
# Re-checking costs one round trip and returns a bodyless 304 when unchanged.
/css/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/js/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

# Exhibition mini-sites keep their stylesheet inside their own folder. Matching
# on the extension covers every exhibition, present and future, without
# touching their HTML — which must keep revalidating like every other page.
/exhibitions/*.css
  ! Cache-Control
  Cache-Control: public, max-age=3600

# Safe to cache forever ONLY because an image's bytes never change under a
# fixed name: to replace an artwork photo, give it a new filename (the version
# prefix in build-images.sh) and update the srcset. Overwriting in place would
# leave returning visitors on the old photo for up to a year, and no
# Cloudflare purge can reach a file already in their browser.
/img/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
